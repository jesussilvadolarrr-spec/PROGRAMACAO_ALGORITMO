ALGORITMO "COLOCACAO_RANKING"
//LOGICA DE PROGRAMAÇÃO BÁSICA
//DATA ATUAL: 18/09/2026
VAR
   NOMES:VETOR[1..5] DE CARACTERE
   NOTAS:VETOR[1..5] DE REAL
   I, J:INTEIRO
   AUX_NOTA:REAL
   AUX_NOME:CARACTERE

INICIO
   //LEITURA DE DADOS
   PARA I DE 1 ATE 5 FACA
      ESCREVA("NOME DO CANDITADO: ", I, ": ")
      LEIA(NOMES[I])
      ESCREVA("NOTAS DE ", NOMES[I], ": ")
      LEIA(NOTAS[I])
   FIMPARA

   //ORDENAÇÃO EM ORDEM CRESCENTE
   PARA I DE 1 ATE 5 FACA
      PARA J DE 1 ATE 5  - I FACA
         SE NOTAS[J] < NOTAS [J + 1] ENTAO
            //TROCA DE NOTA
            AUX_NOTA <- NOTAS[J]
            NOTAS[J] <- NOTAS[J + 1]
            NOTAS[J + 1] <- AUX_NOTA
            //TROCA DE NOME
            AUX_NOME <- NOMES[J]
            NOMES[J] <-NOMES[J + 1]
            NOMES[J + 1] <- AUX_NOME
         FIMSE
      FIMPARA
   FIMPARA
   //EXIBIÇÃO DO RANKING (APENAS NOTAS > 7,0)
   ESCREVAL("---RANKING (ACIMA DE 7,0 PONTOS) ---")
   PARA I DE 1 ATE 5 FACA
      SE (NOTAS[I] >= 7) ENTAO
         ESCREVAL(I, "O LUGAR: ", NOMES[I], " - ", NOTAS[I], "PONTOS. ")
      FIMSE
   FIMPARA
FIMALGORITMO