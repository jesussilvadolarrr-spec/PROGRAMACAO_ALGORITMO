algoritmo "TURMA_NOTA-MEDIAS_FINAIS"
//DESCRIÇÃO: UTILIZA VETORES PARARELOS PARA ARMAZENAR DADOS DE MUTIPLOS ALUNOS
//CALCULAR A MEDIA ARITMETICA E EXIBE UM RELATORIO ALINHADO
var
   NOME:VETOR[1..13] DE CARACTERE  //GUARDA OS TEXTOS (NUMERO DOS ALUNOS)
   N1:VETOR[1..13] DE REAL         //GUARDA AS PRIMEIRAS NOTAS (NUMEROS DECIMAIS)
   N2:VETOR[1..13] DE REAL         //GUAARDA AS SEGUNDAS NOTAS
   M:VETOR[1..13] DE REAL          //GUARDA AS MEDIAS CALCULAS
   I:INTEIRO                    //VARIAVEL CONTADORA PARA O LACO 'PARA'

   //NOVAS VARIAVEIS ADICIONADAS
   //SM: SOMA DAS MEDIAS (FUNCIONARA COMO UM ACUMULADOR)
   //MT: MEDIA DA TURMA (GUARDARA O RESULTADO FINAL DA CLASSE)
   //TOTAL_MEDIA: QUANTIDADE DE ALUNOS ACIMA DA MEDIA (FUNCIONARA COMO UM CONTADOR)
   SM, MT, TOTA_MEDIA: REAL

inicio
   //BLOCO 1: ENTRADA E PROCESSAMENTO DE DADOS
   //O LAÇO VAI REPETIR 13 VEZES, MUDANDO O VALOR DE 'I' DE 1 ATE 13
   PARA I <- 1 ATE 13 FACA
      ESCREVAL("--- ALUNO ---", I, " ---")

      ESCREVA("NOME: ")
      LEIA(NOME[I]) //ARMAZENA O NOME DIGITADO NA POSIÇÃO 'I' DO VETOR 'NOME'

      ESCREVA("PRIMEIRA NOTA: ")
      LEIA(N1[I]) //ARMAZENA A NOTA 1 NA MESMA POSIÇÃO 'I' DO VETOR 'N1'

      ESCREVA("SEGUNDA NOTA: ")
      LEIA(N2[I])

      ESCREVAL ("") //PULA UMA LINHA NO CONSOLE PARA ESTETICA
      //CALCULO DA MEDIA
      //OS PARENTESES GARATEM QUE A SOMA ANTE DA DIVISÃO 2.
      M[I] <- (N1[I] + N2[I]) / 2

      //ACUMULADOR:
      //A CADA REPETIÇÃO, ELE PEGA O VALOR QUE JA TINHA EM 'SM' E SOMA COM A NOVA MEDIA
      SM <- SM + M[I]
   FIMPARA

   //CALCULO DA MEDIA GERAL DA TURMA:
   //PEGA A SOMA DE TODAS AS MEDIAS (SM) E DIVIDE PELA QUANTIDADE DE ALUNOS (13)
   MT <- SM/13

   LIMPATELA //LIMPARA TELA APOS QUATRO LEITURA PARA EXIBIR O BOLETIM LIMPO

   //BLOCO 2: SAIDA DE DADOS FORMATADA
   ESCREVAL("LISTA DE ALUNOS E MEDIAS")
   ESCREVAL("------------------------")

   //NOVO LAÇO PARA PERCORRER OS VETORES PREENCHIDOS E EXIBIR DADOS
   PARA I <- 1 ATE 13 FACA
      //FORMATAÇÃO DE SAIDA:
      //NOME(I):15 -> RESERVA 15 ESPAÇOS NA TELA PARA O NOME (CRIAR UM ALINHAMENTO EM
      //M(i):4:2 ->EXIBE A MEDIA USANDO 4 ESPAÇOS TOTAIS, SENDOS 2 CASAS DECIMAIS
      ESCREVAL(NOME[I]:15, "| MEDIA: ", M[I]:13:2)

      //ESTRUTURA CONDICIONAL PARA VERIFICAR O DESEMPENHO:
      //SE A MEDIA DO ALUNO ATUAL (M[1]) FOR MAIOR QUE A MEDIA GERAL DA TURMA (MT)...
      SE (M[I] > MT) ENTAO
         //CONTADOR:
         //ADICIONA +1 A CONTAGEM DE ALUNOS QUE SUPERARAM A MEDIA DA TURMA
         TOTAL_MEDIA <- TOTAL_MEDIA + 1
      FIMSE
   FIMPARA

   //EXIBIÇÃO DOS DADOS ESTATISTICOS FINAIS:
   //MOSTRA QUANTOS ALUNOS FICARAM ACIMA DA MEDIA E QUAL FOI O VALOR EXATO DESSA MEDIA DA TURMA
   ESCREVAL("AO TODOS TEMOS ", TOTAL_MEDIA, " ALUNOS ACIMA DA MEDIA DA TURMA QUE E ", MT:4:1)
FIMALGORITMO