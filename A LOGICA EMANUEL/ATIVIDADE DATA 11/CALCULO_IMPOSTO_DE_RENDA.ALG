Algoritmo "CALCULO_IMPOSTO_DE_RENDA"
//LOGICA DE PROGRAMAÇÃO BASICA
// Data atual  : 11/09/2026
Var
   SALARIO_MINIMO, RENDA_MENSAL, IMPOSTO: REAL
   DESCONTO, QTD_SALARIOS, RENDA_LIQUIDA:REAL
   CPF:CARACTER
   NUM_DEPENDENTE, I:INTEIRO
Inicio
   //SOLICITAR O VALOR DO SALARIO MINIMO ATUAL
   ESCREVAL("INFORME O VALOR ATUAL DO SALARIO MINIMO: ")
   LEIA(SALARIO_MINIMO)

   //INICIAR UM LAÇO DE REPETIÇÃO QUE VAI DE 1 A 10
   PARA I DE 1 ATE 10 FACA
      ESCREVAL("-----------------DADOS DO CONTRIBUENTE----------------")

      //LEITURA DO CPF DO CONTRIBUENTE
      ESCREVAL("DIGITE SEU CPF: ")
      LEIA(CPF)

      //LEITURA DA RENDA MENSAL DO CONTRIBUENTE
      ESCREVA("DIGITE A RENDA MENSAL: ")
      LEIA(RENDA_MENSAL)

      //CALCULAR AO DESCONTO: 5%
      DESCONTO <- NUM_DEPENDENTE * (SALARIO_MINIMO * 0.05)

      //CALCULAR A RENDA LIQUIDA SUBTRAINDO O DESCONTO DA RENDA
      RENDA_LIQUIDA <- RENDA MENSAL - DESCONTO

      //DESCOBRE QUANTOSSALARIOS MINIMOS A RENDA LIQUIDA
      QTD_SALARIOS <- RENDA_LIQUIDA / SALARIO_MINIMO

      //VERIFICAR EM QUAL FAIXA DE ALIQUOTA A RENDA LIQUIDA
      SE (QTD_SALARIOS <= 2) ENTAO
         //QTD DE 2 SALARIOS MINIMOS: ISENTO
         IMPOSTO <- 0
      SENAO
         //QTD DE 2 A 3 SALARIOS MINIMOS
         SE(QTD_SALARIOS <= 3) ENTAO
            IMPOSTO <- RENDA_LIQUIDA * 0.05
         SENAO
            //QTD DE 3 A 5 SALARIOS MINIMOS
            SE (QTD_SALARIOS <= 5)ENTAO
               IMPOSTO <- RENDA_LIQUIDA * 0.10
            SENAO
               //QTD DE 5 A 7 SALARIOS MINIMOS
               SE(QTD SALARIO_MINIMOS <= 7)ENTAO
                  IMPOSTO <= RENDA_LIQUIDA * 0.20
               FIMSE
            FIMSE
         FIMSE
      FIMSE

      ESCREVAL("CPF: ", CPF)
      ESCREVAL("RENDA_LIQUIDA: R$ ", RENDA_LIQUIDA)
      ESCREVAL("IMPOSTO A PAGA: R$ ", IMPOSTO
      ESCREVAL("--------------------------------------")
      ESCREVAL("")
   FIMPARA

Fimalgoritmo