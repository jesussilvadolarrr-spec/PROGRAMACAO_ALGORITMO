Algoritmo "SOMA_ATE_ZERO"
//LOGICA DE PROGRAMAÇÃO
//ESTRUTURA DE REPETIÇÃO
// Data atual  : 10/09/2026
VAR
NUMERO, SOMA: INTEIRO


Inicio
  SOMA <- 0
  ESCREVA("DIGITE UM NUMERO (0 PARA PARAR): ")
  LEIA(NUMERO)
  
  ENQUANTO (NUMERO <> 0) FACA
  SOMA <- SOMA + NUMERO
  ESCREVA ("DIGITE UM NUMERO(0 PARA PARAR)")
  LEIA(NUMERO)
  FIMENQUANTO
  
  ESCREVAL("A SOMA TOTAL FOI: ", SOMA)

Fimalgoritmo               '


































































































































































































































































































































































































