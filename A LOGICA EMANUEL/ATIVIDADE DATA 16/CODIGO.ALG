Algoritmo "CODIGO"
//LOGICA DE PROGRAMAÇÃO BASICA
// Data atual  : 09/09/2026
Var
   CODIGO:INTEIRO
   PRECO:REAL

   //ENTRADA DE DADOS
Inicio
   ESCREVA("INFORME O PRECO DO PRODUTO: ")
   LEIA(PRECO)
   ESCREVA("INFORME O NUMERO DO CODIGO (1 A 30): ")
   LEIA(CODIGO)

   //SE A VARIAVEL FOR IGUAL 1...
   CASO (CODIGO = 1) ENTAO
      ESCREVAL("SUL")
   FIMSE
   //SE A VARIAVEL FOR IGUAL 2...
   SE(CODIGO = 2) ENTAO
      ESCREVAL("NORTE")
   FIMSE
   //SE A VARIAVEL FOR IGUAL 3...
   SE (CODIGO = 3)ENTAO
      ESCREVAL("LESTE")
   FIMSE
   //SE A VARIAVEL FOR IGUAL 4...
   SE (CODIGO = 4)ENTAO
      ESCREVAL("OESTE")
   FIMSE
   //SE A VARIAVEL FOR IGUAL 5...
   SE (CODIGO = 5)ENTAO
      ESCREVAL("NORDESTE")
   FIMSE
   //SE A VARIAVEL FOR IGUAL 6...
   SE (CODIGO = 6)ENTAO
      ESCREVAL("NORDESTE")
   FIMSE
   //SE A VARIAVEL FOR IGUAL 7...
   SE (CODIGO = 7)ENTAO
      ESCREVAL("SULDESTE")
   FIMSE
   //SE A VARIAVEL FOR IGUAL 8...
   SE (CODIGO = 8)ENTAO
      ESCREVAL("SULDESTE")
   FIMSE
   //SE A VARIAVEL FOR IGUAL 9...
   SE (CODIGO = 9)ENTAO
      ESCREVAL("SULDESTE")
   FIMSE
   //SE A VARIAVEL FOR IGUAL 10...
   SE (CODIGO = 10)ENTAO
      ESCREVAL("CENTRO-OESTE")
   FIMSE
   //SE A VARIAVEL FOR IGUAL 11...
   SE (CODIGO = 11)ENTAO
      ESCREVAL("CENTRO-OESTE")
   FIMSE
   //SE A VARIAVEL FOR IGUAL 12...
   SE (CODIGO = 12)ENTAO
      ESCREVAL("CENTRO-OESTE")
   FIMSE
   //SE A VARIAVEL FOR IGUAL 13...
   SE (CODIGO = 13)ENTAO
      ESCREVAL("CENTRO-OESTE")
   FIMSE
   //SE A VARIAVEL FOR IGUAL 14...
   SE (CODIGO = 14)ENTAO
      ESCREVAL("CENTRO-OESTE")
   FIMSE
   //SE A VARIAVEL FOR IGUAL 15...
   SE (CODIGO = 15)ENTAO
      ESCREVAL("CENTRO-OESTE")
   FIMSE
   //SE A VARIAVEL FOR IGUAL 16...
   SE (CODIGO = 16)ENTAO
      ESCREVAL("CENTRO-OESTE")
   FIMSE
   //SE A VARIAVEL FOR IGUAL 17...
   SE (CODIGO = 17)ENTAO
      ESCREVAL("CENTRO-OESTE")
   FIMSE
   //SE A VARIAVEL FOR IGUAL 18...
   SE (CODIGO = 18)ENTAO
      ESCREVAL("CENTRO-OESTE")
   FIMSE
   //SE A VARIAVEL FOR IGUAL 19...
   SE (CODIGO = 19)ENTAO
      ESCREVAL("CENTRO-OESTE")
   FIMSE
   //SE A VARIAVEL FOR IGUAL 20...
   SE (CODIGO = 20)ENTAO
      ESCREVAL("NORDESTE")
   FIMSE
   //SE A VARIAVEL FOR IGUAL 21...
   SE (CODIGO = 11)ENTAO
      ESCREVAL("NORDESTE")
   FIMSE
   //SE A VARIAVEL FOR IGUAL 22...
   SE (CODIGO = 22)ENTAO
      ESCREVAL("NORDESTE")
   FIMSE
   //SE A VARIAVEL FOR IGUAL 23...
   SE (CODIGO = 23)ENTAO
      ESCREVAL("NORDESTE")
   FIMSE
   //SE A VARIAVEL FOR IGUAL 24...
   SE (CODIGO = 24)ENTAO
      ESCREVAL("NORDESTE")
   FIMSE
   //SE A VARIAVEL FOR IGUAL 25...
   SE (CODIGO = 25)ENTAO
      ESCREVAL("NORDESTE")
   FIMSE
   //SE A VARIAVEL FOR IGUAL 26...
   SE (CODIGO = 26)ENTAO
      ESCREVAL("NORDESTE")
   FIMSE
   //SE A VARIAVEL FOR IGUAL 27...
   SE (CODIGO = 27)ENTAO
      ESCREVAL("NORDESTE")
   FIMSE
   //SE A VARIAVEL FOR IGUAL 28...
   SE (CODIGO = 28)ENTAO
      ESCREVAL("NORDESTE")
   FIMSE
   //SE A VARIAVEL FOR IGUAL 29...
   SE (CODIGO = 29)ENTAO
      ESCREVAL("NORDESTE")
   FIMSE
   //SE A VARIAVEL FOR IGUAL 30...
   SE (CODIGO = 30)ENTAO
      ESCREVAL("NORDESTE")
   FIMSE


   SE (CODIGO < 1) OU (CODIGO > 30) ENTAO
      ESCREVAL("VALOR INVALIDO")
   FIMSE

FIMALGORITMO