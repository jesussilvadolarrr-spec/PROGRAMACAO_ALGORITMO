ALGORITMO "TABUADA_INFINITA_repita"
//DATA 15/9/26
VAR
  n, CON: INTEIRO

INICIO
ESCREVAL("DIGITE UM NUMERO (OU -1 PARA SAIR): ")
LEIA(n)

REPITA
ESCREVAL("--TABUADA DE ", N, "--")
CON <- 1

REPITA
ESCREVAL(N, " X ", CON, " = ", CON * N)
CON <- CON + 1
ATE (CON > 10)

ESCREVAL("")
ESCREVA("DIGITE OUTRO NUMERO(OU -1 PARA SAIR): ")
LEIA(N)
ATE(N = -1)

FIMALGORITMO
