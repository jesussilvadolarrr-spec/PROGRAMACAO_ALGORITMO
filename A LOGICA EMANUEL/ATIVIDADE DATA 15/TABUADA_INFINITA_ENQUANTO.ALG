ALGORITMO "TABUADA_INFINITA_ENQUANTO"
//DATA 15/9/26
VAR
  n, CON: INTEIRO

INICIO
ESCREVAL("DIGITE UM NUMERO (OU -1 PARA SAIR): ")
LEIA(n)

ENQUANTO (N <> -1) FACA

ESCREVAL("--TABUADA DO ", N, "--")
CON <- 1
ENQUANTO (CON <= 10)FACA
ESCREVAL(N, " X ", CON, " = ", CON * N)
CON <- CON + 1
FIMENQUANTO

ESCREVAL("")
ESCREVA("DIGITE OUTRO NUMERO (OU -1 PARA SAIR: )")
LEIA(N)
FIMENQUANTO
FIMALGORITMO


