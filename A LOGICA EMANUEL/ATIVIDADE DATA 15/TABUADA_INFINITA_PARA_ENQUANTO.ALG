ALGORITMO "TABUADA_INFINITA_PARA_ENQUANTO"
//DATA 15/9/26
VAR
   n, CON: INTEIRO

INICIO
   ESCREVAL("DIGITE UM NUMERO (OU -1 PARA SAIR): ")
   LEIA(n)

   ENQUANTO (N <> -1)FACA
      ESCREVAL("--TABUADA DO ", N, "--")

      PARA CON DE 1 ATE 10 FACA
         ESCREVA(N, " N ", CON, " = ", CON * N)
      FIMPARA

      ESCREVAL("")
      ESCREVA("DIGITE OUTRO NUMERO (OU -1 PARA SAIR: ")
      LEIA(N)
   FIMENQUANTO


FIMALGORITMO
