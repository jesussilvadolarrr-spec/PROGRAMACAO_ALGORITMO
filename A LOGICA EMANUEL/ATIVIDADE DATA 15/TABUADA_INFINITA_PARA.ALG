ALGORITMO "TABUADA_INFINITA_PARA"
//DATA 15/9/26
VAR
   n, CON, X: INTEIRO

INICIO
   ESCREVAL("DIGITE UM NUMERO (OU -1 PARA SAIR): ")
   LEIA(n)

   PARA X DE 1 ATE 5 FACA
   
   SE(N = -1)ENTAO
   INTERROMPA
   FIMSE
   
   ESCREVAL("-- TABUADA DO ", N, "--")
   
   PARA CON DE 1 ATE 10 FACA
   ESCREVAL(N, " X ", CON, " = ", CON * N)
   FIMPARA
   
   ESCREVAL("")
   ESCREVA("DIGITE OUTRO NUMERO(OU -1 PRA SAIR): ")
   LEIA (N)
   FIMPARA
FIMALGORITMO
