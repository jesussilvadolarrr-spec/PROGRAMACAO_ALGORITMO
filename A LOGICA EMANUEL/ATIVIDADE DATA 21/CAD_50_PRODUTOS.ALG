ALGORITMO "CAD_50_PRODUTOS"
//LOGICA DE PROGRAMAÇÃO BASICA
//QUESTAO 2
//DATA ATUAL : 21/09/26
VAR
NOME: VETOR [1..50] DE CARACTERE
CUSTO, PRECO, LUCRO_PROD: VETOR[1..50]
I: INTEIRO
INICIO
PARA I DE 1 ATE 50 FACA
ESCREVA("NOME DO PRODUTO: ", I, ": ")
LEIA(NOME[I])

ESCREVA("CUSTO:")
LEIA(CUSTO[I])

ESCREVA ("PREÇO DE VENDA: ")
LEIA(PRECO[I])

// CALCULO DO PERCENTUAL DE LUCRO
LUCRO_PROD[I] <- ((PRECO[I] - CUSTO [I])) / CUSTO [I] * 100
FIMPARA
ESCREVAL("A) PRODUTO COM LUCRO 10%: ")
PARA I DE 1 ATE 5 FACA
SE (LUCRO_PROD[I] < 10) ENTAO
ESCREVAL(NOME[I])
FIMSE
FIMPARA

ESCREVAL("B) PRODUTO COM LUCRO ENTRE 10% E 30%: ")
PARA I DE 1 ATE 5 FACA
SE (LUCRO_PROD[I] >= 10) E (LUCRO_PROD[I] <= 30) ENTAO
ESCREVAL(NOME[I])
FIMSE
FIMPARA

ESCREVAL("B) PRODUTO COM LUCRO MAIOR 30%: ")
PARA I DE 1 ATE 5 FACA
SE (LUCRO_PROD[I] >= 30) E (LUCRO_PROD[I] <= 30) ENTAO
ESCREVAL(NOME[I])
FIMSE
FIMPARA

FIMALGORITMO