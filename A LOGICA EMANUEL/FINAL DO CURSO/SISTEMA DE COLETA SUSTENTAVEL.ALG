ALGORITMO "SISTEMA DE COLETA SUSTENTAVEL"
//SABER SOBRE A COLETA DE LIXO ;)
VAR
PESO, TOTALPESO, ECOPONTOS:REAL
QUANTIDADELOTES: INTEIRO
INICIO
TOTALPESO <- 0
QUANTIDADELOTES <- 0

ESCREVA("DIGITE O PESO DO LOTE EM KG(DIGITE 0 PARA ENCERRAR): ")
LEIA(PESO)

ENQUANTO PESO <> 0 FACA

TOTALPESO <- TOTALPESO + PESO
QUANTIDADELOTES <- QUANTIDADELOTES + 1
ESCREVA("DIGITE O PESO DO LOTE EM KG (DIGITE 0 PARA ENCERRAR): ")
LEIA(PESO)

FIMENQUANTO

ECOPONTOS <- TOTALPESO * 50

ESCREVAL("")
ESCREVAL("QUANTIDADE DE LOTES ENTREGUES: ": QUANTIDADELOTES)
ESCREVAL("PESO TOTAL ARRECADADO: ", TOTALPESO:0:2, "KG")
ESCREVAL("ECOPONTOS GERADOS: ",ECOPONTOS)
FIMALGORITMO


