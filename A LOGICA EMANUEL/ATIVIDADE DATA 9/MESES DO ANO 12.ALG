Algoritmo "MESES DO ANO"
//LOGICA DE PROGRAMAÇÃO BASICA
// Data atual  : 09/09/2026
Var
   MES:INTEIRO
   //ENTRADA DE DADOS
Inicio
   ESCREVA("INFORME O NUMERO DO MES (1 A 12): ")
   LEIA(MES)
   //SE A VARIAVEL FOR IGUAL 1...
   SE (MES = 1) ENTAO
      ESCREVAL("JANEIRO")
   FIMSE
   //SE A VARIAVEL FOR IGUAL 2...
   SE(MES = 2) ENTAO
      ESCREVAL("FEVEREIRO")
   FIMSE
   //SE A VARIAVEL FOR IGUAL 3...
   SE (MES = 3)ENTAO
      ESCREVAL("MARÇO")
      FIMSE
   //SE A VARIAVEL FOR IGUAL 4...
   SE (MES = 4)ENTAO
      ESCREVAL("ABRIL")
   FIMSE
   //SE A VARIAVEL FOR IGUAL 5...
   SE (MES = 5)ENTAO
      ESCREVAL("MAIO")
   FIMSE
   //SE A VARIAVEL FOR IGUAL 6...
   SE (MES = 6)ENTAO
      ESCREVAL("JUNHO")
   FIMSE
   //SE A VARIAVEL FOR IGUAL 7...
   SE (MES = 7)ENTAO
      ESCREVAL("JULHO")
   FIMSE
   //SE A VARIAVEL FOR IGUAL 8...
   SE (MES = 8)ENTAO
      ESCREVAL("AGOSTO")
   FIMSE
   //SE A VARIAVEL FOR IGUAL 9...
   SE (MES = 9)ENTAO
      ESCREVAL("SETEMBRO")
   FIMSE
   //SE A VARIAVEL FOR IGUAL 10...
   SE (MES = 10)ENTAO
      ESCREVAL("OUTUBRO")
   FIMSE
   //SE A VARIAVEL FOR IGUAL 11...
   SE (MES = 11)ENTAO
      ESCREVAL("NOVEMBRO")
   FIMSE
   //SE A VARIAVEL FOR IGUAL 12...
   SE (MES = 12)ENTAO
      ESCREVAL("DEZEMBRO")
   FIMSE


   SE (MES < 1) OU (MES > 12) ENTAO
      ESCREVAL("VALOR INVALIDO")
   FIMSE
Fimalgoritmo