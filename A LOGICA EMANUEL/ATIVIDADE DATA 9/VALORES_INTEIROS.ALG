ALGORITMO  "VALORES_INTEIROS"
//LOGICA DE PROGRAMACÃO
//DATA ATUAL : 09/9/26
VAR
   A, B, C, MENOR: INTEIRO
INICIO
   ESCREVA("PRIMEIRO VALOR: ")
   LEIA(A)
   ESCREVA("SEGUNDO VALOR: ")
   LEIA(B)
   ESCREVA("TERCEIRO VALOR: ")
   LEIA(C)

   SE(A < B) E (A < C) ENTÃO
      MENOR <- A
   SENAO
      SE B < C ENTAO
         MENOR <- B
      SENAO
         MENOR <- C
      FIMSE
   FIMSE

   ESCREVAL("MENOR = ", MENOR)
FIMALGORITMO