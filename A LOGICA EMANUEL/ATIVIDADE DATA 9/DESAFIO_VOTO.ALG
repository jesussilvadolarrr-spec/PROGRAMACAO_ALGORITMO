Algoritmo "DESAFIO_VOTO"

// Data atual  : 09/09/2026
Var
IDADE: REAL
Inicio
ESCREVA("DIGITE SUA IDADE: ")
LEIA(IDADE)

SE(IDADE <= 15)ENTAO
ESCREVAL("NAO PODERAR")
FIMSE

SE(IDADE >= 16)ENTAO
ESCREVAL("FACULTATIVO")
FIMSE

SE(IDADE >=18)ENTAO
ESCREVAL("VOTO OBRIGATORIO")
FIMSE

SE (IDADE >=70)ENTAO
ESCREVAL("VOTA SE QUISER")
FIMSE
Fimalgoritmo